PORT=3001
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-this-with-a-long-random-secret

# Optional. Without this, rooms are held in memory for local development.
# DATABASE_URL=postgres://moto:moto@localhost:5432/moto_trips

# OSRM-compatible Directions endpoint. The public demo endpoint is suitable
# for development only; production deployments should use a hosted instance.
ROUTING_URL=https://router.project-osrm.org
# Contact email identifying this app to the public Nominatim geocoder.
APP_CONTACT_EMAIL=you@example.com

# Optional. Set this when the frontend and API are hosted on different origins.
VITE_API_URL=
# Minimum time between GPS emits while the app is visible (milliseconds).
VITE_GPS_UPDATE_INTERVAL_MS=2000
